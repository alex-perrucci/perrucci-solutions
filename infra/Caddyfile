# Perrucci Solutions — snippet per il Caddy GIA' esistente sulla VPS.
# NON sostituire il Caddyfile attuale di Fluxa Platform / GuidaLavoroItalia.
# Prima del reload verificare che le porte locali 8088 e 8098 siano libere.

perruccisolutions.com, www.perruccisolutions.com {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8088

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}

api.perruccisolutions.com {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8098
}

# Perrucci Solutions — Caddy drop-in for the shared VPS reverse proxy.
# Install as /data/sites-enabled/perrucci.caddy inside fluxa-caddy-1
# (host volume: /var/lib/docker/volumes/fluxa_caddy_data/_data/sites-enabled/perrucci.caddy).
# Requires the shared Caddyfile to define (common_security) and import /data/sites-enabled/*.

perruccisolutions.com, www.perruccisolutions.com {
	import common_security
	reverse_proxy perrucci-web:80
	log {
		output stdout
		format json
	}
}

api.perruccisolutions.com {
	import common_security
	request_body {
		max_size 2MB
	}
	reverse_proxy perrucci-marketing:8000
	log {
		output stdout
		format json
	}
}

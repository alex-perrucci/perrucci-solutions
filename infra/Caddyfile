# Perrucci Solutions — snippet per il Caddy GIA' esistente sulla VPS.
# NON sostituire il Caddyfile attuale di Fluxa Platform / GuidaLavoroItalia.
# I container Perrucci si collegano alla rete Docker esterna `fluxa_edge`,
# già usata dal Caddy pubblico `fluxa-caddy-1`.

perruccisolutions.com, www.perruccisolutions.com {
  encode zstd gzip
  reverse_proxy perrucci-web:80

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}

api.perruccisolutions.com {
  encode zstd gzip
  reverse_proxy perrucci-marketing:8000
}
